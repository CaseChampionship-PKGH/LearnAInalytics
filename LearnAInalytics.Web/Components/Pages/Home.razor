@page "/"
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer
@using LearnAInalytics.Api.Models
@using System.Text

<PageTitle>Анализ тестов</PageTitle>

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-lg-7 col-md-10">
			<h1 class="display-5 mb-3">Анализ результатов тестов</h1>
			<p class="lead text-muted">Загрузите ответы и получите интеллектуальный отчёт с рекомендациями.</p>

			<div class="card mb-4">
				<div class="card-body p-4">
					<h5 class="card-title fw-bold mb-3">Исходные данные</h5>

					<div class="mb-3">
						<label class="form-label fw-bold">
							Файл с ответами тестируемых <span class="text-danger">*</span>
						</label>
						<InputFile OnChange="HandleUserFile" class="form-control" accept=".json,.csv,.zip" />
						@if (userFile != null)
						{
							<small class="text-success mt-1 d-block">@userFile.Name</small>
						}
					</div>

					<div class="mb-3">
						<label class="form-label fw-bold">
							Файл с эталонными ответами
						</label>
						<InputFile OnChange="HandleRefFile" class="form-control" accept=".json,.csv,.zip" />
						@if (refFile != null)
						{
							<small class="text-success mt-1 d-block">@refFile.Name</small>
						}
					</div>

					<div class="mb-4">
						<label class="form-label fw-bold">Вариант ИИ-агента</label>
						<select @bind="selectedVariant" class="form-select">
							<option value="russian">Российские нейросети</option>
							<option value="foreign">Зарубежные нейросети</option>
						</select>
					</div>

					<button class="btn btn-primary btn-lg w-100" @onclick="StartAnalysis" disabled="@isLoading">
						@if (isLoading)
						{
							<span class="spinner-border spinner-border-sm me-2" role="status"></span>
							<span>Анализируем...</span>
						}
						else
						{
							<span>Запустить анализ</span>
						}
					</button>
				</div>
			</div>

			@if (isLoading)
			{
				<div class="text-center my-5">
					<div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
						<span class="visually-hidden">Загрузка...</span>
					</div>
					<p class="mt-3 text-muted">Идёт анализ... Пожалуйста, подождите.</p>
				</div>
			}

			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger d-flex align-items-center" role="alert">
					<span>@errorMessage</span>
					<button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = string.Empty"></button>
				</div>
			}

			@if (analysisResult != null)
			{
				<div class="card card-result mb-4">
					<div class="card-header bg-success">
						Результаты анализа
					</div>
					<div class="card-body p-4">
						<div class="row g-4">
							<div class="col-sm-6">
								<div class="p-3 rounded" style="background-color: #f0f9f5;">
									<div class="fs-4 fw-bold">@analysisResult.Summary.TotalQuestions</div>
									<small class="text-muted">Всего вопросов</small>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="p-3 rounded" style="background-color: #fff8e7;">
									<div class="fs-4 fw-bold">@analysisResult.Summary.TotalUsers</div>
									<small class="text-muted">Тестируемых</small>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="p-3 rounded" style="background-color: #f3e8ff;">
									<div class="fs-4 fw-bold">@analysisResult.Summary.OverallCorrectPercentage.ToString("F1")%</div>
									<small class="text-muted">Правильных ответов</small>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="p-3 rounded" style="background-color: #ffeaea;">
									<div class="fs-4 fw-bold">@analysisResult.CriticalIssues.Count</div>
									<small class="text-muted">Критических вопросов</small>
								</div>
							</div>
						</div>

						<div class="d-flex gap-3 mt-4">
							<button class="btn btn-success" @onclick="DownloadExcel">
								Скачать Excel
							</button>
							<button class="btn btn-outline-primary" @onclick="DownloadJson">
								Скачать JSON
							</button>
						</div>
					</div>
				</div>

				@if (analysisResult.CriticalIssues.Any())
				{
					<div class="card card-result border-danger">
						<div class="card-header bg-danger">
							Критические вопросы
						</div>
						<div class="card-body">
							<ul class="list-group list-group-flush">
								@foreach (var issue in analysisResult.CriticalIssues)
								{
									<li class="list-group-item border-0">@issue</li>
								}
							</ul>
						</div>
					</div>
				}
			}
		</div>
	</div>
</div>

@code {
	private IBrowserFile? userFile;
	private IBrowserFile? refFile;
	private string selectedVariant = "foreign";
	private bool isLoading;
	private string? errorMessage;
	private ReportDataApiModel? analysisResult;
	private string? reportDataJson;
	private ReportDataApiModel? reportDataObject;

	private void HandleUserFile(InputFileChangeEventArgs e) => userFile = e.File;
	private void HandleRefFile(InputFileChangeEventArgs e) => refFile = e.File;

	private async Task StartAnalysis()
	{
		if (userFile == null)
		{
			errorMessage = "Не выбран файл с ответами тестируемых.";
			return;
		}

		isLoading = true;
		errorMessage = null;
		analysisResult = null;
		StateHasChanged();

		try
		{
			using var formData = new MultipartFormDataContent();

			var userFileContent = new StreamContent(userFile.OpenReadStream(maxAllowedSize: 100_000_000));
			userFileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(userFile.ContentType ?? "application/octet-stream");
			formData.Add(userFileContent, "userAnswers", userFile.Name);

			if (refFile != null)
			{
				var refFileContent = new StreamContent(refFile.OpenReadStream(maxAllowedSize: 100_000_000));
				refFileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(refFile.ContentType ?? "application/octet-stream");
				formData.Add(refFileContent, "referenceAnswers", refFile.Name);
			}

			var analysisMethodString = selectedVariant == "russian" ? "RussianAiAgent" : "ForeignAiAgent";
			var requestUri = $"api/analysis/run?analysisMethod={analysisMethodString}";
			var response = await Http.PostAsync(requestUri, formData);

			if (response.IsSuccessStatusCode)
			{
				reportDataJson = await response.Content.ReadAsStringAsync();
				reportDataObject = System.Text.Json.JsonSerializer.Deserialize<ReportDataApiModel>(
					reportDataJson,
					new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

				analysisResult = reportDataObject;
			}
			else
			{
				var errorJson = await response.Content.ReadAsStringAsync();
				errorMessage = $"Ошибка сервера: {response.StatusCode}. {errorJson}";
			}
		}
		catch (Exception ex)
		{
			errorMessage = $"Ошибка подключения: {ex.Message}";
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task DownloadJson()
	{
		if (reportDataJson == null) return;
		byte[] bytes = Encoding.UTF8.GetBytes(reportDataJson);
		using var stream = new MemoryStream(bytes);
		using var streamRef = new DotNetStreamReference(stream);
		await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, "report.json");
	}

	private async Task DownloadExcel()
	{
		if (reportDataObject == null) return;
		var response = await Http.PostAsJsonAsync("api/analysis/export/excel", reportDataObject);
		if (response.IsSuccessStatusCode)
		{
			var bytes = await response.Content.ReadAsByteArrayAsync();
			using var stream = new MemoryStream(bytes);
			using var streamRef = new DotNetStreamReference(stream);
			await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, "report.xlsx");
		}
		else
		{
			errorMessage = "Не удалось скачать Excel-отчёт.";
		}
	}
}
