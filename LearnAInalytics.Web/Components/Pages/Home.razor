@page "/"
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer
@using LearnAInalytics.Api.Models
@using LearnAInalytics.Web.Models
@using LearnAInalytics.Services.Contracts.Constants

<PageTitle>Анализ анкет</PageTitle>

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-lg-12 col-md-10">
			<h1 class="display-5 mb-3">Анализ анкет</h1>
			<p class="lead text-muted">Загрузите ответы и получите интеллектуальный отчёт с визулизации.</p>

			<div class="card mb-4">
				<div class="card-body p-4">
					<h5 class="card-title fw-bold mb-3">Исходные данные</h5>

					<div class="mb-3">
						<label class="form-label fw-bold">
							Файл с ответами слушателей <span class="text-danger">*</span>
						</label>
						<InputFile OnChange="HandleSurveyFile" class="form-control" accept=".xlsx,.csv" />
						@if (surveyFile != null)
						{
							<small class="text-success mt-1 d-block">@surveyFile.Name</small>
						}
					</div>

					<div class="mb-4">
						<label class="form-label fw-bold">Вариант ИИ-агента</label>
						<select @bind="selectedVariant" class="form-select">
							<option value="russian">Российские нейросети</option>
							<option value="foreign">Зарубежные нейросети</option>
						</select>
					</div>

					<button class="btn btn-primary btn-lg w-100" @onclick="StartAnalysis" disabled="@isLoading">
						@if (isLoading)
						{
							<span class="spinner-border spinner-border-sm me-2" role="status"></span>
							<span>Анализируем...</span>
						}
						else
						{
							<span>Запустить анализ</span>
						}
					</button>
				</div>
			</div>

			@if (isLoading)
			{
				<div class="text-center my-5">
					<div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
						<span class="visually-hidden">Загрузка...</span>
					</div>
					<p class="mt-3 text-muted">Идёт анализ... Пожалуйста, подождите.</p>
				</div>
			}

			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="alert alert-danger d-flex align-items-center" role="alert">
					<span>@errorMessage</span>
					<button type="button" class="btn-close ms-auto" @onclick="() => errorMessage = string.Empty"></button>
				</div>
			}

			@if (dashboardData != null)
			{
				<div class="card mt-4">
					<div class="card-header bg-primary text-white">
						<h5>Результаты анализа</h5>
					</div>
					<div class="card-body">
						<div class="row">
							<div class="col-md-6 mb-4">
								<canvas id="barChart"></canvas>
							</div>
							<div class="col-md-6 mb-4">
								<canvas id="radarChart"></canvas>
							</div>
						</div>
						<div class="row">
							<div class="col-md-12 mb-4">
								<canvas id="heatMap" style="max-width:100%;"></canvas>
							</div>
						</div>
						<div class="row align-items-center">
							<div class="col-md-6 mb-3">
								<canvas id="distChart"></canvas>
							</div>
							<div class="col-md-6">
								<div class="card bg-light p-3">
									<h4>Общая удовлетворённость</h4>
									<div class="display-4 text-success fw-bold">@dashboardData.OverallSatisfaction.ToString("F1")</div>
									<small>из 10</small>
								</div>
							</div>
						</div>
					</div>
					<div class="card-footer d-flex gap-3">
						<button class="btn btn-success" @onclick="DownloadExcel">
							Скачать Excel
						</button>
						<button class="btn btn-outline-primary" @onclick="DownloadWord">
							Скачать Word
						</button>
					</div>
				</div>
			}
		</div>
	</div>
</div>

@code {
	private IBrowserFile? surveyFile;
	private string selectedVariant = "foreign";
	private bool isLoading;
	private string? errorMessage;
	private AnalysisResultApiModel? analysisResult;
	private AnalysisResultApiModel? analysisResultObject;
	private string? analysisDataJson;
	private DashboardData? dashboardData;

	private void HandleSurveyFile(InputFileChangeEventArgs e) => surveyFile = e.File;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (dashboardData != null)
		{
			await RenderCharts();
		}
	}

	private async Task RenderCharts()
	{
		await JS.InvokeVoidAsync("renderBarChart", dashboardData!.CriteriaLabels, dashboardData.AverageScores.Values.ToArray());
		await JS.InvokeVoidAsync("renderRadarChart", dashboardData.CriteriaLabels, dashboardData.SpiderValues.Values.ToArray());
		await JS.InvokeVoidAsync("renderHeatMap", dashboardData.CriteriaLabels, dashboardData.HeatMapData);
		await JS.InvokeVoidAsync("renderDistributionChart", dashboardData.DistributionCounts);
	}

	private async Task StartAnalysis()
	{
		if (surveyFile == null)
		{
			errorMessage = "Не выбран файл с анкетой";
			return;
		}

		isLoading = true;
		errorMessage = null;
		analysisResult = null;
		StateHasChanged();

		try
		{
			using var formData = new MultipartFormDataContent();

			var userFileContent = new StreamContent(surveyFile.OpenReadStream(maxAllowedSize: 100_000_000));
			userFileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(surveyFile.ContentType ?? "application/octet-stream");
			formData.Add(userFileContent, "userAnswers", surveyFile.Name);

			var analysisMethodString = selectedVariant == "russian" ? "RussianAiAgent" : "ForeignAiAgent";
			var requestUri = $"api/analysis/run?analysisMethod={analysisMethodString}";
			var response = await Http.PostAsync(requestUri, formData);

			if (response.IsSuccessStatusCode)
			{
				analysisDataJson = await response.Content.ReadAsStringAsync();
				analysisResultObject = System.Text.Json.JsonSerializer.Deserialize<AnalysisResultApiModel>(
					analysisDataJson,
					new System.Text.Json.JsonSerializerOptions
					{
						PropertyNameCaseInsensitive = true,
						Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
					});

				analysisResult = analysisResultObject;
				PrepareDashboardData(analysisResultObject!);
				StateHasChanged();
				await Task.Delay(200); // дождаться рендера
				await JS.InvokeVoidAsync("renderBarChart", dashboardData!.CriteriaLabels, dashboardData.AverageScores.Values.ToArray());
				await JS.InvokeVoidAsync("renderRadarChart", dashboardData.CriteriaLabels, dashboardData.SpiderValues.Values.ToArray());
				await JS.InvokeVoidAsync("renderHeatMap", dashboardData.CriteriaLabels, dashboardData.HeatMapData);
				await JS.InvokeVoidAsync("renderDistributionChart", dashboardData.DistributionCounts);
			}
			else
			{
				var errorJson = await response.Content.ReadAsStringAsync();
				errorMessage = $"Ошибка сервера: {response.StatusCode}. {errorJson}";
			}
		}
		catch (Exception ex)
		{
			errorMessage = $"Ошибка подключения: {ex.Message}";
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task DownloadWord()
	{
		if (analysisResultObject == null) return;
		var response = await Http.PostAsJsonAsync("api/analysis/export/word", analysisResultObject);
		if (response.IsSuccessStatusCode)
		{
			var bytes = await response.Content.ReadAsByteArrayAsync();
			using var stream = new MemoryStream(bytes);
			using var streamRef = new DotNetStreamReference(stream);
			await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, "report.docx");
		}
		else
		{
			errorMessage = "Не удалось скачать Word-отчёт.";
		}
	}

	private async Task DownloadExcel()
	{
		if (analysisResultObject == null) return;
		var response = await Http.PostAsJsonAsync("api/analysis/export/excel", analysisResultObject);
		if (response.IsSuccessStatusCode)
		{
			var bytes = await response.Content.ReadAsByteArrayAsync();
			using var stream = new MemoryStream(bytes);
			using var streamRef = new DotNetStreamReference(stream);
			await JS.InvokeVoidAsync("downloadFileFromStream", streamRef, "report.xlsx");
		}
		else
		{
			errorMessage = "Не удалось скачать Excel-отчёт.";
		}
	}

	private void PrepareDashboardData(AnalysisResultApiModel result)
	{
		var criteria = result.AllCriteriaAnalysisData;
		var avgScores = new Dictionary<string, double>();
		var spider = new Dictionary<string, double>();

		foreach (var c in criteria)
		{
			double val = c.CriterionData.Statistics?.Average ?? 0;
			if (c.CriterionData.CriterionName == SurveyAnalysisConstants.Engagement)
			{
				val = c.CriterionData.Statistics?.NoPercent / 10 ?? 0;
			}
			avgScores[c.CriterionData.CriterionName] = val;
			spider[c.CriterionData.CriterionName] = val;
		}

		double[][] heatMap = CalculateCorrelationMatrix(SurveyAnalysisConstants.CriteriaNames, result);

		// Распределение общей оценки (по всем числовым критериям)
		int low = 0, med = 0, high = 0;
		foreach (var crit in criteria.Where(c => c.CriterionData.Statistics?.Distribution != null))
		{
			var dist = crit.CriterionData.Statistics.Distribution;
			low = Convert.ToInt32(crit.CriterionData.Statistics.PercentLow * 100);
			med = Convert.ToInt32(crit.CriterionData.Statistics.PercentMedium * 100);
			high = Convert.ToInt32(crit.CriterionData.Statistics.PercentHigh * 100);
		}

		dashboardData = new DashboardData
		{
			AverageScores = avgScores,
			SpiderValues = spider,
			HeatMapData = heatMap,
			CriteriaLabels = SurveyAnalysisConstants.CriteriaNames,
			DistributionCounts = new[] { low, med, high },
			OverallSatisfaction = Math.Round(avgScores.Values.Average(), 1)
		};
	}

	private double[][] CalculateCorrelationMatrix(string[] labels, AnalysisResultApiModel result)
	{
		// Формируем словарь: название критерия -> список оценок (восстановленных из Distribution)
		var data = new Dictionary<string, List<double>>();
		foreach (var c in result.AllCriteriaAnalysisData)
		{
			var stats = c.CriterionData?.Statistics;
			if (stats == null) continue;

			if (stats.Average.HasValue && stats.Distribution != null && stats.Distribution.Count > 0)
			{
				// Восстанавливаем вектор оценок
				var scores = new List<double>();
				foreach (var kv in stats.Distribution)
					for (int i = 0; i < kv.Value; i++)
						scores.Add(kv.Key);
				data[c.CriterionData!.CriterionName] = scores;
			}
			else if (c.CriterionData!.CriterionName == SurveyAnalysisConstants.Engagement)
			{
				// Для вовлечённости кодируем 1 = "Да", 0 = "Нет"
				var engScores = new List<double>();
				int yes = stats.YesCount ?? 0;
				int no = stats.NoCount ?? 0;
				for (int i = 0; i < yes; i++) engScores.Add(1);
				for (int i = 0; i < no; i++) engScores.Add(0);
				data[c.CriterionData.CriterionName] = engScores;
			}
		}

		int n = labels.Length;
		double[][] matrix = new double[n][];
		for (int i = 0; i < n; i++)
		{
			matrix[i] = new double[n];
			for (int j = 0; j < n; j++)
			{
				if (data.ContainsKey(labels[i]) && data.ContainsKey(labels[j]) &&
					data[labels[i]].Count == data[labels[j]].Count && data[labels[i]].Count > 1)
				{
					matrix[i][j] = Math.Round(PearsonCorrelation(data[labels[i]], data[labels[j]]), 2);
				}
				else
				{
					matrix[i][j] = (i == j) ? 1.0 : 0.0;
				}
			}
		}
		return matrix;
	}

	private double PearsonCorrelation(List<double> x, List<double> y)
	{
		int n = x.Count;
		double sumX = x.Sum(), sumY = y.Sum();
		double sumX2 = x.Sum(v => v * v), sumY2 = y.Sum(v => v * v);
		double sumXY = x.Zip(y, (a, b) => a * b).Sum();

		double numerator = n * sumXY - sumX * sumY;
		double denominator = Math.Sqrt((n * sumX2 - sumX * sumX) * (n * sumY2 - sumY * sumY));
		return denominator == 0 ? 0 : numerator / denominator;
	}
}
